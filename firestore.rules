rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requesting user is an admin.
    // It checks if a document with the user's UID exists in the 'admins' collection.
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Helper function for checking a user's role from the users collection.
    // This is safe to use for rules on OTHER collections (like sales or dashboard).
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Allow admins to manage who is in the admins list.
    match /admins/{userId} {
      allow read, write: if isAdmin();
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // An admin can create, read, update, and delete any user document.
      // This now works because isAdmin() reads from a *different* collection.
      allow create, read, update, delete: if isAdmin();

      // A non-admin user can read and update their OWN document.
      allow read, update: if request.auth.uid == userId;
    }

    // Rules for the 'sales' collection
    match /sales/{saleId} {
      // Sellers can create new sales documents.
      allow create: if getUserRole() == 'seller';
      
      // Admins and Sellers can read sales documents.
      allow read: if isAdmin() || getUserRole() == 'seller';
    }
    
    // Rules for the 'dashboard' collection
    match /dashboard/metrics {
      // Admins and Sellers can read dashboard data.
      allow read: if isAdmin() || getUserRole() == 'seller';
      
      // Only sellers can write to the dashboard.
      allow write: if getUserRole() == 'seller';
    }
  }
}
